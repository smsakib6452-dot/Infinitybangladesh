# ==============================================================================
# INFINITY BANGLADESH — ENVIRONMENT CONFIGURATION TEMPLATE
# Official Identity: Team Infinity | United for Humanity | Est. 2015
# Location: Hathazari, Chattogram, Bangladesh
# ==============================================================================
# Copy this file to .env and insert your project credentials.
# NEVER commit your actual .env file or sensitive production keys to git.

# ------------------------------------------------------------------------------
# 1. CLOUDINARY DIRECT CLOUD MEDIA STORAGE (Unsigned Upload REST API)
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL, AUTH & STORAGE (Optional Live Database Sync)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Dashboard: Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
VITE_SUPABASE_STORAGE_BUCKET=infinity-media

# Optional Local / Offline Emergency Admin Password (used if Supabase Auth is unconfigured)
# VITE_ADMIN_PASSWORD=your-super-secure-admin-password

# Optional Service Role Key (for server-side / Edge functions only — NEVER expose in frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. SITE & BRAND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://infinitybangladesh.org
VITE_ORGANIZATION_NAME="Infinity Bangladesh"
VITE_ORGANIZATION_SLOGAN="United for Humanity"
VITE_OFFICIAL_ADDRESS="Hathazari, Chattogram, Bangladesh"
VITE_OFFICIAL_PHONE="+880 1800-000000"
VITE_OFFICIAL_EMAIL="contact@infinitybangladesh.org"

# ------------------------------------------------------------------------------
# 4. PAYMENT & DONATION CHANNELS (Display & API reference)
# ------------------------------------------------------------------------------
VITE_BKASH_NUMBER="01800-000000"
VITE_NAGAD_NUMBER="01800-000000"

# Optional tokenized checkout API keys (if integrated)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# ------------------------------------------------------------------------------
# 5. EMAIL SERVICE & NOTIFICATIONS (Optional Resend / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
